# Cheghadr build-time configuration template (safe — no real values).
# Copy to .env (never committed; .gitignore already excludes *.env / .env)
# or export the variables in CI / your shell.

# ---------------------------------------------------------------------------
# Release signing (optional locally; used by .github/workflows/release.yml
# when present). NEVER commit real keystores or passwords.
# ---------------------------------------------------------------------------
CHEGHADR_KEYSTORE_PATH=/absolute/path/to/cheghadr-release.jks
CHEGHADR_KEYSTORE_PASSWORD=change-me
CHEGHADR_KEY_ALIAS=cheghadr
CHEGHADR_KEY_PASSWORD=change-me

# GitHub Actions release workflow additionally accepts the keystore base64-
# encoded as the repository secret CHEGHADR_KEYSTORE_B64 (it is decoded to a
# temporary file for signing and never stored in the repo).

# ---------------------------------------------------------------------------
# Runtime provider configuration (entered by the user in the app's Settings
# screen — kept here only as documentation; nothing below is compiled in).
# ---------------------------------------------------------------------------
# Optional CoinGecko demo API key — relaxes public-endpoint rate limits.
# Get one at https://www.coingecko.com/en/api (free demo plan).
CHEGHADR_COINGECKO_DEMO_KEY=

# TGJU-compatible source (DISABLED by default). The Iranian free market,
# domestic gold, coins and Tehran indices activate only when the user points
# the app at an endpoint they are authorized to use under TGJU's terms
# (https://gem.tgju.org/terms). Example shape of the expected JSON widget
# response is documented in docs/DATA_SOURCES.md.
CHEGHADR_TGJU_BASE_URL=
CHEGHADR_TGJU_ENABLED=false

# ---------------------------------------------------------------------------
# Providers that need NO configuration (active by default):
#   CoinPaprika, open.er-api.com, Frankfurter, gold-api.com
# ---------------------------------------------------------------------------
